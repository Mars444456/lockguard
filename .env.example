# ==============================================================================
# LockGuard Environment Configuration (.env)
# ==============================================================================

# Server Port
PORT=3000

# Telegram Bot Integration (Required for bin/bot.js 24/7 assistant)
TELEGRAM_BOT_TOKEN=your_token_here

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Base URL for the dashboard and callbacks
APP_URL=http://localhost:3000

# Security / Authentication
# SQLite file. Legacy .json paths are migrated to a sibling .sqlite3 without overwriting JSON.
LOCKGUARD_DB_FILE=
LOCKGUARD_ALLOW_REGISTRATION=true
# Set only addresses of proxies you control; otherwise forwarded client IPs are ignored.
LOCKGUARD_TRUST_PROXY_IPS=
# Production accounts require APP_URL=https://your-server.example
# Keep local backups private; copy them to a separate protected location for disaster recovery.
LOCKGUARD_BACKUP_DIR=
LOCKGUARD_BACKUP_HOURS=24
LOCKGUARD_BACKUP_RETENTION=7
# Optional bootstrap key, used only when creating a new database. Set a random secret.
DEFAULT_API_KEY=

# Optional GitHub webhook integration for the operator's repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
# Comma-separated repositories permitted for the operator's primary organization.
GITHUB_REPOSITORIES=
# Enable publishing the lockguard commit status only after configuring permissions.
GITHUB_PUBLISH_STATUS=false

# Robokassa for a self-employed merchant. Match the algorithm in the shop settings.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_HASH_ALGORITHM=sha256
# Test mode is the default and never grants production access.
ROBOKASSA_TEST_MODE=true
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# Notifications Webhook (Optional; Slack / Discord incoming webhook)
SLACK_WEBHOOK_URL=
# Operator access to the primary organization. Customers use account sessions.
# Set a long random secret; absent token disables operator access.
LOCKGUARD_ADMIN_TOKEN=
