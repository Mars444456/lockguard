# ==============================================================================
# LockGuard Environment Configuration (.env)
# ==============================================================================

# Server Port
PORT=3000

# Telegram Bot Integration (Required for bin/bot.js 24/7 assistant)
TELEGRAM_BOT_TOKEN=your_token_here

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Base URL for the dashboard and callbacks
APP_URL=http://localhost:3000

# Security / Authentication
# Default API key seeded for instant local testing without signup
DEFAULT_API_KEY=lg_live_demo998877665544332211

# GitHub OAuth Integration (Optional for local testing; demo bypass available in UI)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Stripe Billing Integration (Optional; automated safe mock simulator runs if omitted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=price_team_monthly_39
STRIPE_BUSINESS_PRICE_ID=price_biz_monthly_99

# Notifications Webhook (Optional; Slack / Discord incoming webhook)
SLACK_WEBHOOK_URL=
