{
  "name": "lockguard",
  "version": "1.5.0",
  "description": "Automated PostgreSQL CI/CD gatekeeper and AST migration analyzer for detecting dangerous table locks",
  "main": "src/core/index.js",
  "bin": {
    "lockguard": "./bin/lockguard.js"
  },
  "scripts": {
    "check:privacy": "node scripts/check-privacy.js",
    "demo:pilot": "node scripts/build-pilot.js",
    "build:browser": "node scripts/build-browser.js",
    "build:legal": "node scripts/build-legal.js && node scripts/prepare-seller-site.js",
    "backup": "node --env-file-if-exists=.env scripts/backup-db.js",
    "restore": "node scripts/restore-db.js",
    "verify:restore": "node --env-file-if-exists=.env scripts/verify-restore.js",
    "start:durable": "node --env-file-if-exists=.env scripts/durable-server.js",
    "pro": "node --env-file-if-exists=.env scripts/manage-pro.js",
    "test:postgres": "node --test integration/postgres-locks.cjs",
    "test:browser": "playwright test",
    "preview:server": "node scripts/preview-server.js",
    "start": "node src/server/server.js",
    "server": "node src/server/server.js",
    "dev": "node src/server/server.js",
    "check": "node bin/lockguard.js check fixtures/09_catastrophic_combined.sql",
    "check:safe": "node bin/lockguard.js check fixtures/10_safe_migration.sql",
    "check:pr": "node bin/lockguard.js check fixtures/ --format=github-pr-comment",
    "rules": "node bin/lockguard.js rules",
    "bot": "node bin/bot.js",
    "test": "node --test"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "migration",
    "linter",
    "lock",
    "access-exclusive",
    "ci-cd",
    "github-action",
    "dba",
    "prisma",
    "drizzle",
    "alembic"
  ],
  "author": "LockGuard Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "libpg-query": "18.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14",
    "pg": "8.23.1"
  }
}
